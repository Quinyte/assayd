# The Node pin in package.json#engines is only a promise until something checks
# it. engine-strict makes pnpm refuse to install on a Node this workspace has
# not been built on, rather than letting a subtly different runtime produce a
# subtly different dist/.
engine-strict=true

# Astro and Starlight reach for peer dependencies that pnpm's strict, isolated
# node_modules would otherwise hide from them.
auto-install-peers=true
strict-peer-dependencies=false
