{
  "name": "@assayd/web",
  "version": "0.0.0",
  "private": true,
  "description": "Scaffold for the two assayd web targets. Builds; carries no content.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": "24.16.0",
    "pnpm": "11.8.0"
  },
  "scripts": {
    "build": "./scripts/build.sh",
    "build:site": "pnpm --filter @assayd/site run build",
    "build:docs": "pnpm --filter @assayd/docs run build",
    "check": "pnpm -r --workspace-concurrency=1 run check",
    "check:warnings": "./scripts/check-warnings.sh",
    "check:links": "./scripts/check-links.sh",
    "check:claims": "./scripts/check-claims.sh",
    "dev:site": "pnpm --filter @assayd/site run dev",
    "dev:docs": "pnpm --filter @assayd/docs run dev"
  }
}
